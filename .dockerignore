# The corpus and its results are mounted, never baked in: the link sheet is 4 MB
# and the results grow to gigabytes, and an image carrying a snapshot of either
# would be stale the moment it was built.
#
# scripts/ IS copied in -- run_batch.sh is the entry point, and batch_procs.sh and
# stop_batch.sh go with it.
input/
output/
output_old/
data/
reports/
docs/
tests/

.venv/
.git/
.gitignore
.mypy_cache/
.ruff_cache/
__pycache__/
**/__pycache__/
*.pyc
*.log
